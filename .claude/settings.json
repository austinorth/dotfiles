{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/austin/.tmux/agent-status.sh on"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/austin/.tmux/agent-status.sh done"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/austin/.tmux/agent-status.sh off"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false,
  "model": "sonnet",
  "showClearContextOnPlanAccept": true,
  "useAutoModeDuringPlan": false,
  "disableAutoMode": "disable"
}
